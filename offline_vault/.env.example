# Supabase and Auth Configuration
# Pass these via --dart-define when building or running the Flutter app:
# flutter run --dart-define-from-file=.env (Flutter 3.7+)
# or:
# flutter run \
#   --dart-define=SUPABASE_URL=https://your-project.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=eyJhbGciOi... \
#   --dart-define=GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
